{
    "compilerOptions": {
      "jsx": "react-jsx",
      "lib": ["esnext", "dom"],
      "checkJs": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      },
      "types": ["vite/client"]
    },
    "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "src/App.jsx"],
    "exclude": ["node_modules", "**/node_modules", "dist"]
  }
  